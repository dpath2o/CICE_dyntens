#!/bin/bash
#PBS -N dyntens01-baseline
#PBS -P gv90
#PBS -q normalbw
#PBS -l walltime=02:00:00
#PBS -l ncpus=1232
#PBS -l mem=1200GB
#PBS -l jobfs=5GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -W umask=022

# Single bounded control or g=1 test; never submits another job.
set -eo pipefail
case_dir="${PBS_O_WORKDIR:?Submit from dyntens01}"
cd -P "$case_dir"
case_dir="$(pwd -P)"
test -f ice_in
test -f cice.settings
repo_dir="$(git rev-parse --show-toplevel)"
test "$case_dir" = "$repo_dir/dyntens01"

# Use the same case environment as the successful build.
if [ "${DYNTENS_BASELINE_ENV_READY:-0}" != 1 ]; then
    export DYNTENS_BASELINE_ENV_READY=1
    exec csh -f -c 'source ./cice.settings; if ($status != 0) exit 2; source ./env.${ICE_MACHCOMP}; if ($status != 0) exit 2; exec bash ./cice.baseline.run'
fi
# Define the Bash module function after inheriting the C-shell module environment.
source "${MODULESHOME:?}/init/bash"
set -u
export DYNTENS_MODE="${DYNTENS_MODE:-control}"
case "$DYNTENS_MODE" in
    control|g1) ;;
    *) echo "DYNTENS_MODE must be control or g1"; exit 2 ;;
esac
test "${ICE_NTASKS}" = "${PBS_NCPUS}"
test -x "${ICE_RUNDIR}/cice"
test "${ICE_NTHRDS}" = 1

# Require the selected two-day September restart baseline.
python3 - <<'PY'
import pathlib, re
text = pathlib.Path("ice_in").read_text()
def value(name):
    hits = re.findall(r"^\s*" + re.escape(name) + r"\s*=\s*([^!\n]+)", text, re.M | re.I)
    if len(hits) != 1:
        raise SystemExit(f"Expected one {name} assignment")
    return hits[0].strip().strip("\u0027\u0022").lower()
expected = dict(npt_unit="d", npt="2", runtype="initial",
                ice_ic="./input_restart/iced.2000-09-01-00000.nc",
                restart_fsd=".true.", use_restart_time=".true.",
                year_init="2000", month_init="9", day_init="1",
                nprocs="1232", grid_ice="c", tr_fsd=".true.", nfsd="12",
                use_dyntens=".false.", kdyn="1", evp_algorithm="standard_2d",
                visc_method="avg_zeta", yield_curve="ellipse", revised_evp=".false.")
for name, want in expected.items():
    if value(name) != want:
        raise SystemExit(f"Baseline requires {name}={want}; got {value(name)}")
for name in ("grid_file", "kmt_file", "F2_file", "atm_data_dir", "ocn_data_dir"):
    hits = re.findall(r"^\s*" + re.escape(name) + r"\s*=\s*([^!\n]+)", text, re.M)
    path = hits[0].strip().strip("\u0027\u0022")
    if not pathlib.Path(path).exists():
        raise SystemExit(f"Missing {name}: {path}")
PY

baseline_parent="${ICE_RUNDIR}/baselines"
mkdir -p "$baseline_parent"
baseline_run="$(mktemp -d "${baseline_parent}/${DYNTENS_MODE}.XXXXXXXX")"
echo "BASELINE_RUN=$baseline_run"
cp "${ICE_RUNDIR}/cice" "$baseline_run/cice"
cp ice_in cice.settings "env.${ICE_MACHCOMP}" "Macros.${ICE_MACHCOMP}" "$baseline_run/"
# Only the private runtime namelist changes; keep the tracked control disabled.
python3 - "$baseline_run/ice_in" "$DYNTENS_MODE" <<'PY_MODE'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
value = ".true." if sys.argv[2] == "g1" else ".false."
text, count = re.subn(r"(?im)^(\s*use_dyntens\s*=\s*)\.false\.",
                      lambda m: m[1] + value, path.read_text())
if count != 1:
    raise SystemExit("Expected one disabled use_dyntens setting in source namelist")
path.write_text(text)
PY_MODE
printf '%s\n' "$DYNTENS_MODE" > "$baseline_run/dyntens_mode.txt"
mkdir "$baseline_run/history" "$baseline_run/restart"

# Snapshot the parent restart independently of all new output.
restart_source="${ICE_RUNDIR}/restart/iced.2000-09-01-00000.nc"
test -r "$restart_source"
mkdir "$baseline_run/input_restart"
cp "$restart_source" "$baseline_run/input_restart/"
chmod a-w "$baseline_run/input_restart/iced.2000-09-01-00000.nc"
printf '%s\n' "Parent restart supplied from: ~/CICE_runs/frcg-exp03/restart (user-described waves-floe300)" "Copied from: $restart_source" > "$baseline_run/restart_provenance.txt"
ncdump -h "$baseline_run/input_restart/iced.2000-09-01-00000.nc" > "$baseline_run/input_restart/header.txt"
python3 - "$baseline_run/input_restart/header.txt" <<'PY_RESTART'
import pathlib, re, sys
header = pathlib.Path(sys.argv[1]).read_text()
missing = [f"fsd{k:03d}" for k in range(1, 13)
           if not re.search(r"\bfsd" + f"{k:03d}" + r"\s*\(", header)]
if missing:
    raise SystemExit("Restart lacks FSD state: " + ", ".join(missing)
                     + ". Do not disable restart_fsd to bypass this check.")
def attr(*names):
    for name in names:
        match = re.search(r":" + name + r"\s*=\s*(-?\d+)", header)
        if match:
            return int(match.group(1))
    raise SystemExit("Missing restart attribute: " + "/".join(names))
actual = (attr("myear", "nyr"), attr("mmonth", "month"), attr("mday"), attr("msec", "sec"))
if actual != (2000, 9, 1, 0):
    raise SystemExit(f"Unexpected restart date: {actual}")
print("Restart header: 2000-09-01, all 12 FSD variables present; istep1 =", attr("istep1"))
PY_RESTART

git rev-parse HEAD > "$baseline_run/source_commit.txt"
git status --short > "$baseline_run/source_status.txt"
git diff HEAD -- > "$baseline_run/source_changes.patch"
git ls-files --others --exclude-standard > "$baseline_run/untracked_files.txt"
cp cice.baseline.run "$baseline_run/"
module list > "$baseline_run/modules.txt" 2>&1
mpif90 --version > "$baseline_run/compiler.txt" 2>&1
mpirun --version > "$baseline_run/mpi.txt" 2>&1
if command -v nc-config >/dev/null; then
    nc-config --all > "$baseline_run/netcdf.txt"
fi
cd "$baseline_run"
sha256sum cice ice_in cice.settings "env.${ICE_MACHCOMP}" "Macros.${ICE_MACHCOMP}" > SHA256SUMS
sha256sum input_restart/iced.2000-09-01-00000.nc >> SHA256SUMS
export OMP_NUM_THREADS="${ICE_NTHRDS}"
export OMP_SCHEDULE="${ICE_OMPSCHED}"

# Preserve MPI failure status.
set +e
mpirun -np "${ICE_NTASKS}" ./cice > cice.runlog 2>&1
run_status=$?
set -e
printf '%s\n' "$run_status" > mpi_exit_status.txt
if [ "$run_status" -ne 0 ]; then
    echo "Baseline failed: MPI exit $run_status; inspect $baseline_run"
    exit "$run_status"
fi
if ! grep -q 'COMPLETED SUCCESSFULLY' ice_diag.d cice.runlog; then
    echo "Baseline lacks completion marker; inspect $baseline_run"
    exit 1
fi
if ! find history -type f -name '*.nc' -print -quit | grep -q .; then
    echo "Baseline lacks NetCDF history; inspect $baseline_run"
    exit 1
fi
if ! find restart -type f -name '*.nc' -print -quit | grep -q .; then
    echo "Baseline lacks NetCDF restart; inspect $baseline_run"
    exit 1
fi
echo "Execution completed: $baseline_run"
echo "Still required: inspect finite fields, FSD normalisation, dates and restart reproducibility."
